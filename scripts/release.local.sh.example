#!/bin/bash
# Copy to scripts/release.local.sh (git-ignored), fill in your values and run it instead of
# scripts/release.sh. Find your Team ID with: security find-identity -v -p codesigning
export DEVELOPMENT_TEAM="XXXXXXXXXX"
export SIGN_IDENTITY="Developer ID Application"
export NOTARY_PROFILE="my-notary-profile"
export GITHUB_REPO="my-org/ipcalc"

exec "$(dirname "$0")/release.sh" "$@"
